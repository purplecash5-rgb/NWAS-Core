{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nwas-core/research_profile.schema.json",
  "title": "ResearchProfile",
  "type": "object",
  "required": [
    "profile_id",
    "display_name",
    "description",
    "intended_use",
    "source_connectors",
    "iterations",
    "questions_per_iteration",
    "max_results",
    "export_formats",
    "requires_network",
    "risk_notes",
    "audit_requirements"
  ],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "intended_use": { "type": "string", "minLength": 1 },
    "source_connectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["scholarly", "preprint", "repository", "local_demo"]
          },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "iterations": { "type": "integer", "minimum": 1, "maximum": 10 },
    "questions_per_iteration": { "type": "integer", "minimum": 1, "maximum": 12 },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 100 },
    "export_formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["json", "markdown", "citation_report"]
      }
    },
    "requires_network": { "type": "boolean" },
    "risk_notes": {
      "type": "object",
      "required": ["medical_caution", "legal_caution", "financial_caution", "notes"],
      "properties": {
        "medical_caution": { "type": "boolean" },
        "legal_caution": { "type": "boolean" },
        "financial_caution": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "audit_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
